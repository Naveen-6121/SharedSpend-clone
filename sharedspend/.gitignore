# =============================================================
# SharedSpend — .gitignore
# =============================================================

# ─── Secrets & local config ──────────────────────────────────
# NEVER commit real .env files
backend/.env
# frontend developer overrides
frontend/.env.local
frontend/.env.*.local

# ─── Python ──────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo

# Virtual environments
backend/.venv/
backend/venv/
backend/env/

# Test / coverage artifacts
backend/.pytest_cache/
backend/.coverage
backend/htmlcov/
backend/coverage.xml
backend/.mypy_cache/
backend/.ruff_cache/

# ─── Database (local dev data, not source code) ──────────────
*.db
*.sqlite
*.sqlite3

# ─── Node / Frontend ─────────────────────────────────────────
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/.cache/
frontend/build/

# TypeScript incremental build info
frontend/tsconfig.tsbuildinfo
frontend/*.tsbuildinfo

# ─── Logs ────────────────────────────────────────────────────
*.log
*.log.*
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ─── OS / Editor ─────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
Thumbs.db
Desktop.ini
.vscode/
!.vscode/extensions.json
.idea/
*.suo
*.sw?

# ─── Docker local overrides ──────────────────────────────────
docker-compose.override.yml
docker-compose.local.yml

# ─── Misc temporary files ────────────────────────────────────
*.tmp
*.bak
*.orig
*.rej
