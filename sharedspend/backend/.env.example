DATABASE_URL=sqlite+aiosqlite:///./sharedspend.db
# For Render, set APP_ENV=production and provide the existing Neon PostgreSQL URL
# directly in the Render dashboard. Never commit the real URL or its password.
# For Neon, use the URI from Neon Console, for example:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
SECRET_KEY=change_me_to_a_random_32_byte_hex_string
# Render requires a strong, randomly generated SECRET_KEY of at least 32 characters.
# Enter it in the Render dashboard; never place the production value in this file.
APP_ENV=development
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=http://localhost:5173
# In Render, use the exact HTTPS origin of the deployed frontend (no path or wildcard).
