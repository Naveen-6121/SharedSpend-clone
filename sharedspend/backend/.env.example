APP_ENV=development
DATABASE_URL=sqlite+aiosqlite:///./sharedspend.db
# TEST/STAGING only: set APP_ENV=staging and supply the separate Neon TEST URL
# through this ignored .env file or the private process environment. Staging
# never falls back to DATABASE_URL.
# TEST_DATABASE_URL=postgresql://USER:PASSWORD@TEST_HOST/DB?sslmode=require
# PRODUCTION only: Render sets APP_ENV=production and DATABASE_URL in its
# dashboard. Never copy the production URL or credentials into a local test setup.
SECRET_KEY=change_me_to_a_random_32_byte_hex_string
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=http://localhost:5173
# In Render production, use the exact HTTPS origin of the deployed frontend.
